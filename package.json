{
  "name": "bitvoid-server",
  "version": "1.1.0",
  "private": true,
  "description": "Cross-platform local-first BitVoid application Server and administration runtime",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "bitvoid-server": "./src/server.js",
    "bitvoid-admin": "./bin/bitvoid-admin.js",
    "bitvoid-migrate": "./bin/bitvoid-migrate.js",
    "bitvoid-backup": "./bin/bitvoid-backup.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "admin": "node bin/bitvoid-admin.js",
    "migrate": "node bin/bitvoid-migrate.js",
    "backup": "node bin/bitvoid-backup.js",
    "check": "node scripts/check-syntax.js",
    "test": "node --test test/unit/*.test.js test/contract/*.test.js test/integration/*.test.js test/security/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:contract": "node --test test/contract/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:security": "node --test test/security/*.test.js"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/websocket": "^11.0.2",
    "argon2": "^0.45.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "bonjour-service": "^1.3.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "ws": "^8.23.0"
  }
}
