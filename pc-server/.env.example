HOST=0.0.0.0
PORT=8787
BITVOID_SERVER_NAME=BitVoid PC Server
BITVOID_STATE_DIR=.state

# BitVoid Trust Protocol (BVT-1): this PC server identity must match the ESP config.h
# and must be registered in cloud BITVOID_TRUSTED_SERVER_KEYS.
BITVOID_PC_SERVER_ID=bv-pc-server-001
BITVOID_PC_SERVER_SECRET=REPLACE_WITH_UNIQUE_CLOUD_TRUST_SECRET_32_PLUS_CHARACTERS
BITVOID_ESP_TRUST_SECRET=REPLACE_WITH_DIFFERENT_ESP_TRUST_SECRET_32_PLUS_CHARACTERS
BITVOID_GATEWAY_ID=bv-esp12e-gateway-001
BITVOID_CLOUD_SERVER_ID=bv-cloud-server-001

# ESP-12E gateway API address on the local Wi-Fi network (not a dashboard).
BITVOID_GATEWAY_URL=http://192.168.4.1

# Optional cloud synchronization. Local operation works without internet.
# Keep false for fully offline/local-only operation. Set true only when you
# intentionally want the PC server to synchronize with the cloud backend.
BITVOID_CLOUD_SYNC_ENABLED=false
BITVOID_CLOUD_SYNC_URL=https://bitvoid-cloud-api.onrender.com
