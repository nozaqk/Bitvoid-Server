HOST=0.0.0.0
PORT=8787
BITVOID_SERVER_NAME=BitVoid PC Server
BITVOID_STATE_DIR=.state

# ESP-12E admin status polling (must match the ESP config.h dashboard credentials)
# The PC polls the protected ESP dashboard status endpoint every 10 seconds.
BITVOID_GATEWAY_URL=http://192.168.4.1
BITVOID_GATEWAY_ADMIN_USERNAME=Bitvoid
BITVOID_GATEWAY_ADMIN_PASSWORD=Bitvoid2026

# Optional bidirectional sync transport to the BitVoid cloud API.
# Use the exact secret generated for the Render cloud service.
BITVOID_CLOUD_SYNC_URL=https://bitvoid-cloud-api.onrender.com
BITVOID_CLOUD_NODE_ID=campus-node-01
BITVOID_SYNC_SECRET=
