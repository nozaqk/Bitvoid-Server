<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bitvoid.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Applications/BitVoid Server.app/Contents/Resources/start-server.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Applications/BitVoid Server.app/Contents/Resources/server</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/bitvoid-server.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/bitvoid-server.stderr.log</string>
</dict>
</plist>
