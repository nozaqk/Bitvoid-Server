[Unit]
Description=BitVoid Cross-Platform Application Server
Documentation=https://github.com/nozaqk/Bitvoid-Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bitvoid
Group=bitvoid-admin
SupplementaryGroups=bitvoid
WorkingDirectory=/opt/bitvoid-server/server
EnvironmentFile=/etc/bitvoid-server/server.env
Environment=BITVOID_USE_OS_DATA_DIR=true
Environment=BITVOID_DATA_DIR=/var/lib/bitvoid-server
Environment=BITVOID_IPC_SOCKET_MODE=0660
Environment=BITVOID_ENROLLMENT_FILE_MODE=0640
ExecStart=/opt/bitvoid-server/runtime/bin/node /opt/bitvoid-server/server/src/server.js
Restart=on-failure
RestartSec=5
UMask=0077

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bitvoid-server
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
