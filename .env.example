# Required: unique random secret (minimum 32 characters; generate with `openssl rand -base64 48`)
BITVOID_TOKEN_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Network & Server Identity
BITVOID_HOST=0.0.0.0
BITVOID_PORT=8787
BITVOID_DISPLAY_NAME=BitVoid Local Server
BITVOID_DEPLOYMENT_MODE=self-hosted
BITVOID_NETWORK_MODE=lan
BITVOID_MDNS_ENABLED=true
BITVOID_TRUST_PROXY=false

# Storage & Operational Paths
BITVOID_DATABASE_PATH=./data/bitvoid.sqlite
BITVOID_MEDIA_DIR=./data/media
BITVOID_BACKUP_DIR=./data/backups
BITVOID_LOG_DIR=./data/logs
# Local IPC socket/pipe for desktop administration dashboard (auto-selected per OS if empty)
BITVOID_IPC_PATH=

# Session & Attachment Policy
BITVOID_TOKEN_TTL=1h
BITVOID_REFRESH_TTL=30d
BITVOID_MAX_UPLOAD_BYTES=26214400

# Optional TLS (recommended for untrusted LANs; required for remote/VPN/central deployments)
BITVOID_TLS_CERT=
BITVOID_TLS_KEY=
BITVOID_TLS_CA=
